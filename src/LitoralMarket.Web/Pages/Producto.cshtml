@page "{id:int}"
@inject LitoralMarket.Application.Interfaces.IParametrosService Parametros
@using LitoralMarket.Application.Helpers
@model ProductoDetalleModel
@functions {
    static string ResolverRutaImagen(string? imagen)
    {
        if (string.IsNullOrWhiteSpace(imagen)) return string.Empty;
        var img = imagen.Trim();
        if (img.StartsWith("http://") || img.StartsWith("https://") || img.StartsWith("/"))
            return img;
        return $"/images/productos/{img}";
    }
}
@{
    ViewData["Title"] = Model.Producto?.Descripcion ?? "Producto";
    var rutaImagen = Model.Producto is null ? string.Empty : ResolverRutaImagen(Model.Producto.Imagen);
    // Modo "credenciales" sin sesión: se ve el producto y su precio, pero no se compra.
    var soloLectura = await Parametros.GetModoAccesoAsync() == "credenciales"
                      && !(User.Identity?.IsAuthenticated ?? false);
    // Código de proveedor visible solo si ecommerce/CodProveedorEnCatalogo == "1" (cacheado).
    var verCodProveedorParam = await Parametros.MostrarCodProveedorEnCatalogoAsync();
    var verCodProveedor = verCodProveedorParam && !string.IsNullOrWhiteSpace(Model.Producto?.CodProveedor);
    // Límite por stock: solo con ecommerce/LimitarCantidadPorStock = '1' (cacheado). Tope del stepper.
    decimal? maximo = null;
    var stockInsuficiente = false;
    var esFicha = Model.Ficha is not null;
    // Stock / código por variante: mismos parámetros que en el catálogo (cacheados).
    var verStockVariante = esFicha && await Parametros.MostrarStockEnCatalogoAsync();
    if (!esFicha && Model.Producto is { TieneStock: true } prodLimite && await Parametros.LimitarCantidadPorStockAsync())
    {
        maximo = CantidadVentaHelper.MaximoPermitido(prodLimite.Stock, prodLimite.CantidadMinimaVenta, prodLimite.Fraccionado);
        stockInsuficiente = maximo < CantidadVentaHelper.UnidadMinima(prodLimite.CantidadMinimaVenta, prodLimite.Fraccionado);
    }
}

@if (Model.Producto is null)
{
    <div class="alert alert-warning">Producto no encontrado.</div>
}
else
{
    <div class="row g-4">
        <div class="col-md-5 text-center">
            @if (Model.Imagenes.Any())
            {
                var principal = Model.Imagenes.First();
                <img id="imgPrincipalDetalle" src="@principal.Url" class="img-fluid rounded shadow mb-2"
                     alt="@Model.Producto.Descripcion" style="max-height:400px;object-fit:contain;" />
                @if (Model.Imagenes.Count > 1)
                {
                    <div class="d-flex flex-wrap gap-2 justify-content-center mt-2">
                        @foreach (var img in Model.Imagenes)
                        {
                            <img src="@img.Url"
                                 class="rounded border thumb-detalle @(img.Id == principal.Id ? "border-primary" : "")"
                                 style="width:64px;height:64px;object-fit:contain;cursor:pointer"
                                 onclick="cambiarImagenDetalle(this, '@img.Url')" />
                        }
                    </div>
                }
            }
            else if (!string.IsNullOrEmpty(rutaImagen))
            {
                <img src="@rutaImagen" class="img-fluid rounded shadow"
                     alt="@Model.Producto.Descripcion" style="max-height:400px;object-fit:contain;" />
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center bg-light rounded" style="height:300px;">
                    <i class="bi bi-image text-muted" style="font-size:5rem;"></i>
                </div>
            }
        </div>
        <div class="col-md-7">
            <h1 class="fs-2">@Model.Producto.Descripcion</h1>
            @if (verCodProveedor)
            {
                <p class="text-muted small mb-1">Código: @Model.Producto.CodProveedor</p>
            }
            @if (Model.RutaRubro.Any())
            {
                <p class="text-muted">
                    @for (var i = 0; i < Model.RutaRubro.Count; i++)
                    {
                        if (i > 0) { <span class="mx-1">&gt;</span> }
                        <a asp-page="/Catalogo" asp-route-rubroId="@Model.RutaRubro[i].Id">@Model.RutaRubro[i].Descripcion</a>
                    }
                </p>
            }
            else if (!string.IsNullOrEmpty(Model.Producto.RubroNombre))
            {
                <p class="text-muted">
                    <a asp-page="/Catalogo" asp-route-rubroId="@Model.Producto.RubroId">@Model.Producto.RubroNombre</a>
                </p>
            }
            @if (!string.IsNullOrEmpty(Model.Producto.DescripcionLarga))
            {
                <p>@Model.Producto.DescripcionLarga</p>
            }
            @if (esFicha)
            {
                <h2 class="text-primary my-3" id="varPrecio"
                    data-desde="@Model.Producto.Precio.ToString("N2")">
                    <small class="fs-6 fw-normal text-secondary">Desde</small> $@Model.Producto.Precio.ToString("N2")
                </h2>
            }
            else if (Model.Producto.PrecioPromo.HasValue)
            {
                @* Promoción de porcentaje vigente (promociones/descuentos = 1) *@
                <div class="my-3">
                    <span class="producto-precio-tachado fs-6">$@Model.Producto.Precio.ToString("N2")</span>
                    <span class="badge badge-promo-estatico ms-1">-@Model.Producto.PromoPorcentaje!.Value.ToString("0.##")%</span>
                    <h2 class="text-primary mb-0">$@Model.Producto.PrecioPromo.Value.ToString("N2")</h2>
                </div>
            }
            else
            {
                <h2 class="text-primary my-3">$@Model.Producto.Precio.ToString("N2")</h2>
            }
            @if (!esFicha && Model.Producto.PromoLleva.HasValue)
            {
                <p class="producto-promo-nxm mb-3"><i class="bi bi-tags-fill" aria-hidden="true"></i>
                    Promo @Model.Producto.PromoLleva x @Model.Producto.PromoPaga: llevando @Model.Producto.PromoLleva pagás @Model.Producto.PromoPaga@(Model.Producto.PromoAgrupa ? " (se suman las variantes del mismo producto)" : "")</p>
            }

            @if (esFicha)
            {
                <div id="varDetalle" data-ver-stock="@(verStockVariante ? "1" : "0")" data-ver-cod="@(verCodProveedorParam ? "1" : "0")"
                     data-solo-lectura="@(soloLectura ? "1" : "0")">
                    @if (Model.Ficha!.UsaMedidas)
                    {
                        <div class="mb-3">
                            <div class="fw-semibold small mb-1">Medida: <span id="varMedidaSel" class="fw-normal text-secondary">elegí una</span></div>
                            <div class="d-flex flex-wrap gap-2" id="varOpcionesMedida" role="group" aria-label="Medida"></div>
                        </div>
                    }
                    @if (Model.Ficha.UsaColores)
                    {
                        <div class="mb-3">
                            <div class="fw-semibold small mb-1">Color: <span id="varColorSel" class="fw-normal text-secondary">elegí uno</span></div>
                            <div class="d-flex flex-wrap gap-2" id="varOpcionesColor" role="group" aria-label="Color"></div>
                        </div>
                    }
                    <div id="varPromo" class="producto-promo-nxm mb-2 d-none"></div>
                    <div id="varInfo" class="small text-secondary mb-3" aria-live="polite"></div>

                    @if (soloLectura)
                    {
                        <a asp-page="/Login" data-no-prefetch class="btn btn-outline-secondary">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Ingresá para comprar
                        </a>
                    }
                    else
                    {
                        <form asp-page="/Carrito" asp-page-handler="Agregar" method="post" class="d-flex align-items-center gap-2" id="varForm">
                            <input type="hidden" name="productoId" id="varProductoId" value="" />
                            <partial name="_CantidadStepper"
                                     model="@(new CantidadStepperVm(0, Model.Producto.Fraccionado, Model.Producto.CantidadMinimaVenta))" />
                            <button type="submit" class="btn btn-primary px-4" id="varBtnAgregar" disabled>
                                <i class="bi bi-cart-plus me-1"></i> <span id="varBtnTexto">Elegí una opción</span>
                            </button>
                        </form>
                    }
                </div>
                <script type="application/json" id="variantesData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
                {
                    usaMedidas = Model.Ficha.UsaMedidas,
                    usaColores = Model.Ficha.UsaColores,
                    inicial = Model.VarianteInicialId,
                    unidadMinima = CantidadVentaHelper.UnidadMinima(Model.Producto.CantidadMinimaVenta, Model.Producto.Fraccionado),
                    variantes = Model.Ficha.Variantes.Select(x => new
                    {
                        id = x.Id, medidaId = x.MedidaId, medida = x.Medida, colorId = x.ColorId, color = x.Color, colorHex = x.ColorHex,
                        precio = x.Precio, stock = x.Stock, codProveedor = x.CodProveedor, maximo = x.MaximoPermitido,
                        precioPromo = x.PrecioPromo, promoPorcentaje = x.PromoPorcentaje, promoLleva = x.PromoLleva, promoPaga = x.PromoPaga, promoAgrupa = x.PromoAgrupa
                    })
                }))</script>
            }
            else if (!Model.Producto.TieneStock && Model.MostrarSinStock)
            {
                <span class="badge bg-secondary fs-6">Agotado</span>
            }
            else if (Model.Producto.TieneStock && soloLectura)
            {
                <a asp-page="/Login" data-no-prefetch class="btn btn-outline-secondary">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Ingresá para comprar
                </a>
            }
            else if (Model.Producto.TieneStock && stockInsuficiente)
            {
                <span class="badge bg-secondary fs-6" title="El stock disponible no alcanza para la cantidad mínima de venta">Stock insuficiente</span>
            }
            else if (Model.Producto.TieneStock)
            {
                <form asp-page="/Carrito" asp-page-handler="Agregar" method="post" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="productoId" value="@Model.Producto.Id" />
                    <partial name="_CantidadStepper"
                             model="@(new CantidadStepperVm(0, Model.Producto.Fraccionado, Model.Producto.CantidadMinimaVenta, Maximo: maximo))" />
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-cart-plus me-1"></i> Agregar al carrito
                    </button>
                </form>
            }

            <div class="mt-3">
                <a asp-page="/Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Seguir comprando
                </a>
            </div>
        </div>
    </div>
}

@section Scripts {
@if (Model.Ficha is not null)
{
    <script src="~/js/variantes.js" asp-append-version="true"></script>
}
<script>
    function cambiarImagenDetalle(thumb, url) {
        var main = document.getElementById('imgPrincipalDetalle');
        if (main) main.src = url;
        document.querySelectorAll('.thumb-detalle').forEach(t => t.classList.remove('border-primary'));
        thumb.classList.add('border-primary');
    }
</script>
}
