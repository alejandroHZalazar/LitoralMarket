@page "{id:int}"
@using System.Globalization
@model ProductoDetalleModel
@functions {
    static string ResolverRutaImagen(string? imagen)
    {
        if (string.IsNullOrWhiteSpace(imagen)) return string.Empty;
        var img = imagen.Trim();
        if (img.StartsWith("http://") || img.StartsWith("https://") || img.StartsWith("/"))
            return img;
        return $"/images/productos/{img}";
    }
}
@{
    ViewData["Title"] = Model.Producto?.Descripcion ?? "Producto";
    var rutaImagen = Model.Producto is null ? string.Empty : ResolverRutaImagen(Model.Producto.Imagen);
}

@if (Model.Producto is null)
{
    <div class="alert alert-warning">Producto no encontrado.</div>
}
else
{
    <div class="row g-4">
        <div class="col-md-5 text-center">
            @if (Model.Imagenes.Any())
            {
                var principal = Model.Imagenes.First();
                <img id="imgPrincipalDetalle" src="@principal.Url" class="img-fluid rounded shadow mb-2"
                     alt="@Model.Producto.Descripcion" style="max-height:400px;object-fit:contain;" />
                @if (Model.Imagenes.Count > 1)
                {
                    <div class="d-flex flex-wrap gap-2 justify-content-center mt-2">
                        @foreach (var img in Model.Imagenes)
                        {
                            <img src="@img.Url"
                                 class="rounded border thumb-detalle @(img.Id == principal.Id ? "border-primary" : "")"
                                 style="width:64px;height:64px;object-fit:contain;cursor:pointer"
                                 onclick="cambiarImagenDetalle(this, '@img.Url')" />
                        }
                    </div>
                }
            }
            else if (!string.IsNullOrEmpty(rutaImagen))
            {
                <img src="@rutaImagen" class="img-fluid rounded shadow"
                     alt="@Model.Producto.Descripcion" style="max-height:400px;object-fit:contain;" />
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center bg-light rounded" style="height:300px;">
                    <i class="bi bi-image text-muted" style="font-size:5rem;"></i>
                </div>
            }
        </div>
        <div class="col-md-7">
            <h1 class="fs-2">@Model.Producto.Descripcion</h1>
            @if (!string.IsNullOrEmpty(Model.Producto.RubroNombre))
            {
                <p class="text-muted">
                    <a asp-page="/Catalogo" asp-route-rubroId="@Model.Producto.RubroId">@Model.Producto.RubroNombre</a>
                </p>
            }
            @if (!string.IsNullOrEmpty(Model.Producto.DescripcionLarga))
            {
                <p>@Model.Producto.DescripcionLarga</p>
            }
            <h2 class="text-primary my-3">$@Model.Producto.Precio.ToString("N2")</h2>

            @if (!Model.Producto.TieneStock && Model.MostrarSinStock)
            {
                <span class="badge bg-secondary fs-6">Agotado</span>
            }
            else if (Model.Producto.TieneStock)
            {
                // Cantidad mínima de venta: mismo criterio que _ProductoCard (min = step =
                // cantidadMinimaVenta, input readonly) para reutilizar el clamp de site.js.
                var minVenta     = Model.Producto.CantidadMinimaVenta > 1 ? Model.Producto.CantidadMinimaVenta : 0m;
                // "0.##" (no "G"): cantidadMinimaVenta es decimal(10,2) y "G" arrastra los
                // ceros de escala (ej. 4.00) — acá se muestran solo si son significativos.
                var stepDetalle  = minVenta > 0 ? minVenta.ToString("0.##", CultureInfo.InvariantCulture) : (Model.Producto.Fraccionado ? "0.01" : "1");
                var valorInicial = minVenta > 0 ? stepDetalle : (Model.Producto.Fraccionado ? "0.50" : "1");
                var stockMaximo  = Model.Producto.Stock > 0 ? Model.Producto.Stock.ToString("G", CultureInfo.InvariantCulture) : "0";

                <form asp-page="/Carrito" asp-page-handler="Agregar" method="post" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="productoId" value="@Model.Producto.Id" />
                    <div class="cantidad-control">
                        <button type="button" class="btn-cantidad btn-menos" aria-label="Reducir cantidad">
                            <i class="bi bi-dash"></i>
                        </button>
                        <input type="number"
                               name="cantidad"
                               value="@valorInicial"
                               min="@stepDetalle"
                               max="@stockMaximo"
                               step="@stepDetalle"
                               class="cantidad-input"
                               aria-label="Cantidad"
                               readonly="@(minVenta > 0)"
                               title="@(minVenta > 0 ? $"Se vende en múltiplos de {stepDetalle}" : null)" />
                        <button type="button" class="btn-cantidad btn-mas" aria-label="Aumentar cantidad">
                            <i class="bi bi-plus"></i>
                        </button>
                    </div>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-cart-plus me-1"></i> Agregar al carrito
                    </button>
                </form>
            }

            <div class="mt-3">
                <a asp-page="/Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Seguir comprando
                </a>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    function cambiarImagenDetalle(thumb, url) {
        var main = document.getElementById('imgPrincipalDetalle');
        if (main) main.src = url;
        document.querySelectorAll('.thumb-detalle').forEach(t => t.classList.remove('border-primary'));
        thumb.classList.add('border-primary');
    }
</script>
}
