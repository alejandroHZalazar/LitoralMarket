@page
@model LitoralMarket.Web.Pages.Admin.Promociones.IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery AntiforgeryService
@{
    ViewData["Title"] = "Promociones del carrusel";
    var csrfToken = AntiforgeryService.GetAndStoreTokens(HttpContext).RequestToken!;
}

<input type="hidden" id="csrfToken" value="@csrfToken" />
<input type="hidden" id="maxMb" value="@Model.MaxMb" />

<style>
    /* Mismo recuadro que el carrusel del Inicio: proporción fija 3:1 (2:1 en celular) y object-fit: cover. */
    .promo-marco   { position: relative; overflow: hidden; border-radius: 10px; background: var(--bg-subtle); border: 1px solid var(--border-ui); aspect-ratio: 3 / 1; }
    .promo-marco.movil { aspect-ratio: 2 / 1; }
    .promo-marco img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .promo-guia    { border-left: 4px solid var(--dorado); background: var(--bg-surface); border-radius: 10px; }
    .promo-guia code { font-size: .85em; }
    .promo-fila    { border: 1px solid var(--border-ui); border-radius: 10px; background: var(--bg-surface); }
    .promo-pos     { min-width: 2rem; height: 2rem; border-radius: 50%; background: var(--dorado-suave); color: var(--acento-texto); font-weight: 700; }
</style>

<div class="d-flex align-items-center gap-2 mb-3">
    <h2 class="mb-0 fw-bold"><i class="bi bi-images me-2 text-success"></i>Promociones del carrusel</h2>
</div>

<div id="alertaGlobal" class="d-none mb-3"></div>

@if (Model.CarruselActivo)
{
    <div class="alert alert-success py-2 small">
        <i class="bi bi-check-circle-fill me-1"></i>El carrusel está <strong>activo</strong> en la página de inicio
        (parámetro <code>ecommerce / CarruselPromociones</code> = 1).
    </div>
}
else
{
    <div class="alert alert-warning py-2 small">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>El carrusel está <strong>desactivado</strong>: la portada lo muestra solo cuando el
        parámetro <code>ecommerce / CarruselPromociones</code> vale exactamente <code>1</code> (no existe, NULL, 0 u otro valor = oculto).
        Podés cargar las promociones igual y activarlo cuando estén listas.
    </div>
}

<!-- ── FORMATO DE LAS IMÁGENES ─────────────────────────────────────── -->
<div class="promo-guia shadow-sm p-3 mb-4 small">
    <div class="fw-semibold mb-2"><i class="bi bi-info-circle-fill me-1 text-success"></i>Cómo deben ser las imágenes del carrusel</div>
    <p class="mb-2">El carrusel muestra <strong>una imagen por vez, a todo el ancho de la página</strong>, y pasa a la siguiente sola. Para que se vea bien:</p>
    <ul class="mb-2 ps-3">
        <li><strong>Formato:</strong> JPG o WEBP (recomendado, pesan menos). También se aceptan PNG y GIF. Hasta @Model.MaxMb MB por imagen; lo ideal es que pese <strong>menos de 400 KB</strong> para que la portada cargue rápido.</li>
        <li><strong>Tamaño:</strong> <strong>1920 × 640 px</strong>, horizontal, proporción <strong>3:1</strong>. Mínimo 1200 px de ancho. Usá <strong>la misma proporción en todas</strong> las imágenes.</li>
        <li><strong>Si la proporción es otra,</strong> la imagen no se deforma: se recorta en los bordes para llenar el recuadro.</li>
        <li><strong>En celular</strong> el recuadro es más alto (2:1) y se pierde aproximadamente un sexto del ancho de cada lado. Poné el texto, el logo y el botón dentro del <strong>66 % central</strong> de la imagen.</li>
    </ul>
    <div class="fw-semibold mb-1">Estilo</div>
    <ul class="mb-0 ps-3">
        <li>Todo el contenido (título, texto, botón o precio) tiene que estar <strong>dibujado dentro de la imagen</strong>: el carrusel no agrega textos ni botones por encima.</li>
        <li>Letras grandes y con buen contraste; evitá texto chico, que en el celular no se lee.</li>
        <li>Sin bordes ni márgenes blancos, y sin pegar nada importante a los bordes ni a la franja inferior, donde se dibujan los puntos de avance.</li>
        <li>Un mensaje por imagen. Las flechas y los puntos se muestran solos cuando hay 2 o más imágenes.</li>
    </ul>
</div>

@if (!Model.PromosHabilitadas || !Model.DestinosDisponibles)
{
    <div class="alert alert-secondary py-2 small">
        <i class="bi bi-link-45deg me-1"></i><strong>Enlaces de los banners:</strong>
        @if (!Model.PromosHabilitadas)
        {
            <span>para que un banner lleve a los productos de una promoción hace falta el módulo de promociones por cantidad / descuento
            (parámetro <code>promociones / descuentos</code> = <code>1</code>). Los banners funcionan igual, solo como imagen.</span>
        }
        else
        {
            <span>falta crear la tabla de destinos: ejecutá el script <code>sql/carrusel_destinos.sql</code> y recargá la página.
            Los banners funcionan igual, solo como imagen.</span>
        }
    </div>
}
else
{
    <div class="alert alert-light border py-2 small">
        <i class="bi bi-link-45deg me-1"></i><strong>Enlaces de los banners:</strong> cada banner puede llevar a los productos de una promoción
        vigente (por cantidad o por porcentaje). Al hacer clic en el banner completo el cliente ve solo los productos de esa promoción.
        Si la promoción vence o se elimina, el banner sigue mostrándose y la página de destino avisa que ya no está disponible.
    </div>
}

<!-- ── AGREGAR ─────────────────────────────────────────────────────── -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="small fw-semibold text-uppercase text-muted mb-2">Agregar promoción</div>
        <div class="row g-3">
            <div class="col-12 col-lg-5">
                <label class="form-label small mb-1">Imagen <span class="text-muted">(JPG o WEBP de 1920 × 640 px, proporción 3:1 · hasta @Model.MaxMb MB; también PNG o GIF)</span></label>
                <input id="nuevaImagen" type="file" class="form-control form-control-sm" accept="image/jpeg,image/png,image/webp,image/gif" />
                <label class="form-label small mb-1 mt-2">Texto alternativo <span class="text-muted">(opcional, accesibilidad)</span></label>
                <input id="nuevoTitulo" type="text" maxlength="150" class="form-control form-control-sm" placeholder="Ej.: Ofertas de la semana" />
                <button id="btnAgregar" type="button" class="btn btn-success btn-sm mt-3" disabled>
                    <i class="bi bi-plus-lg me-1"></i>Agregar al final del carrusel
                </button>
            </div>
            <div class="col-12 col-lg-7">
                <div class="small text-muted mb-1">Vista previa: así se ve en escritorio (3:1) y en celular (2:1, recortada a los costados)</div>
                <div style="max-width:480px">
                    <div class="promo-marco"><img id="prevTarjeta" alt="" hidden /></div>
                    <div class="promo-marco movil mt-2" style="max-width:240px"><img id="prevMovil" alt="" hidden /></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── LISTADO Y ORDEN ─────────────────────────────────────────────── -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="small fw-semibold text-uppercase text-muted mb-2">
            Promociones cargadas
            <span class="text-muted fw-normal text-lowercase">· se muestran en este orden, una por vez; usá las flechas para cambiarlo</span>
        </div>

        <div id="listaPromos" class="d-flex flex-column gap-2">
            @if (Model.Promociones.Count == 0)
            {
                <div id="sinPromos" class="text-center text-muted py-4">
                    <i class="bi bi-images me-1"></i>Todavía no hay promociones. Agregá la primera arriba.
                </div>
            }
            @foreach (var p in Model.Promociones)
            {
                <div class="promo-fila p-2" data-id="@p.Id">
                    <div class="row g-2 align-items-center">
                        <div class="col-auto d-flex flex-column align-items-center gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" data-accion="subir" title="Subir"><i class="bi bi-chevron-up"></i></button>
                            <span class="promo-pos d-inline-flex align-items-center justify-content-center small" data-pos>@p.Orden</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" data-accion="bajar" title="Bajar"><i class="bi bi-chevron-down"></i></button>
                        </div>
                        <div class="col-12 col-sm" style="min-width:200px;max-width:420px">
                            <div class="promo-marco"><img src="/images/promociones/@p.Id?v=@p.Version" alt="@p.Titulo" loading="lazy" /></div>
                        </div>
                        <div class="col-12 col-md">
                            <input type="text" maxlength="150" class="form-control form-control-sm mb-2" data-titulo
                                   value="@p.Titulo" placeholder="Texto alternativo (opcional)" />
                            @* Destino del banner: promoción por cantidad / porcentaje (se guarda el id de la promoción) *@
                            @if (Model.PromosHabilitadas && Model.DestinosDisponibles)
                            {
                                <div class="promo-destino mb-2" data-destino data-regla="@(p.FkPromocionRegla?.ToString() ?? "")">
                                    <div class="row g-2 align-items-center">
                                        <div class="col-12 col-md-5">
                                            <select class="form-select form-select-sm" data-destino-tipo aria-label="Al hacer clic en el banner">
                                                <option value="">Sin enlace (solo imagen)</option>
                                                <option value="NXM">Lleva a una promoción por cantidad</option>
                                                <option value="PORC">Lleva a una promoción por porcentaje</option>
                                            </select>
                                        </div>
                                        <div class="col-12 col-md-7">
                                            <select class="form-select form-select-sm" data-destino-regla aria-label="Promoción" disabled></select>
                                        </div>
                                    </div>
                                    <div class="small mt-1" data-destino-estado></div>
                                </div>
                            }
                            <div class="d-flex flex-wrap gap-2">
                                <label class="btn btn-sm btn-outline-primary mb-0">
                                    <i class="bi bi-arrow-repeat me-1"></i>Reemplazar imagen
                                    <input type="file" hidden data-reemplazar accept="image/jpeg,image/png,image/webp,image/gif" />
                                </label>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-accion="eliminar">
                                    <i class="bi bi-trash me-1"></i>Eliminar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- ── VISTA PREVIA DEL CARRUSEL ───────────────────────────────────── -->
@if (Model.Promociones.Count > 0)
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="small fw-semibold text-uppercase text-muted mb-2">Vista previa del carrusel</div>
            @{ ViewData["IntervaloSeg"] = Model.IntervaloSegundos; ViewData["SinEnlaces"] = true; }
            <partial name="_CarruselPromociones" model="Model.Promociones" view-data="ViewData" />
            <div class="small text-muted">
                Así se ve en la portada: una imagen por vez a todo el ancho. Avanza sola cada
                @Model.IntervaloSegundos s (parámetro <code>ecommerce / IntervaloCarruselPromociones</code>) y se pausa cuando alguien la mueve.
            </div>
        </div>
    </div>
}

<script id="reglasData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.Reglas.Select(r => new { id = r.Id, nombre = r.Nombre, tipo = r.Tipo, resumen = r.Resumen, vigente = r.Vigente })))</script>
<style>
    .promo-destino { border: 1px dashed var(--border-ui); border-radius: 8px; padding: .5rem; background: var(--bg-subtle); }
</style>
<script>
(function () {
    var TOKEN = document.getElementById('csrfToken').value;
    var MAX_MB = parseInt(document.getElementById('maxMb').value, 10) || 5;
    var ANCHO_MAX = 1920;      // la imagen se ve a todo el ancho: 1920 cubre escritorio de alta resolución sin cargar de más
    var PESO_OK = 400 * 1024;  // por debajo de este peso (y de ANCHO_MAX) se sube tal cual
    var lista = document.getElementById('listaPromos');

    function alerta(msg, tipo) {
        var a = document.getElementById('alertaGlobal');
        a.className = 'alert alert-' + (tipo || 'danger') + ' mb-3';
        a.textContent = msg;
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function post(handler, body, esJson) {
        var headers = { 'X-XSRF-TOKEN': TOKEN };
        if (esJson) headers['Content-Type'] = 'application/json';
        var res = await fetch('?handler=' + handler, { method: 'POST', headers: headers, body: esJson ? JSON.stringify(body) : body });
        try { return await res.json(); }
        catch (e) { return { ok: false, error: 'Respuesta inesperada del servidor (' + res.status + ').' }; }
    }

    // Lee el archivo como data URL (la CSP del sitio no permite blob: en img-src).
    function leerDataUrl(file) {
        return new Promise(function (resolve) {
            var fr = new FileReader();
            fr.onload = function () { resolve(fr.result); };
            fr.onerror = function () { resolve(null); };
            fr.readAsDataURL(file);
        });
    }

    // Reduce a ANCHO_MAX de ancho antes de subir, para no cargar imágenes más grandes de lo necesario.
    // GIF queda como está (para no perder la animación).
    function prepararImagen(file) {
        return new Promise(function (resolve) {
            if (file.type === 'image/gif') { resolve(file); return; }
            var img = new Image();
            img.onload = function () {
                if (img.naturalWidth <= ANCHO_MAX && file.size <= PESO_OK) { resolve(file); return; }
                var escala = Math.min(1, ANCHO_MAX / img.naturalWidth);
                var c = document.createElement('canvas');
                c.width = Math.round(img.naturalWidth * escala);
                c.height = Math.round(img.naturalHeight * escala);
                var ctx = c.getContext('2d');
                ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, c.width, c.height);
                ctx.drawImage(img, 0, 0, c.width, c.height);
                c.toBlob(function (b) { resolve(b || file); }, 'image/jpeg', 0.85);
            };
            img.onerror = function () { resolve(file); };   // el servidor valida el tipo real
            leerDataUrl(file).then(function (u) { if (u) img.src = u; else resolve(file); });
        });
    }

    function validarArchivo(file) {
        if (!file) return 'Elegí una imagen.';
        if (!/^image\/(jpeg|png|webp|gif)$/.test(file.type)) return 'El archivo debe ser JPG, PNG, WEBP o GIF.';
        return null;
    }

    // ── agregar ──────────────────────────────────────────────
    var inpNueva = document.getElementById('nuevaImagen');
    var btnAgregar = document.getElementById('btnAgregar');
    var prev = document.getElementById('prevTarjeta');
    var prevMovil = document.getElementById('prevMovil');

    inpNueva.addEventListener('change', async function () {
        var f = inpNueva.files[0];
        var err = f ? validarArchivo(f) : null;
        if (!f || err) {
            prev.hidden = true; prevMovil.hidden = true;
            btnAgregar.disabled = true;
            if (err) alerta(err, 'warning');
            return;
        }
        var u = await leerDataUrl(f);
        if (u) { prev.src = u; prev.hidden = false; prevMovil.src = u; prevMovil.hidden = false; }
        btnAgregar.disabled = false;
    });

    btnAgregar.addEventListener('click', async function () {
        var f = inpNueva.files[0];
        var err = validarArchivo(f);
        if (err) { alerta(err, 'warning'); return; }
        btnAgregar.disabled = true;
        var blob = await prepararImagen(f);
        var fd = new FormData();
        fd.append('imagen', blob, f.name);
        fd.append('titulo', document.getElementById('nuevoTitulo').value);
        var r = await post('Crear', fd, false);
        if (r.ok) { location.reload(); return; }
        alerta(r.error || 'No se pudo agregar la promoción.');
        btnAgregar.disabled = false;
    });

    // ── destino del banner: promoción por cantidad / porcentaje ─────────────
    var REGLAS = [];
    try { REGLAS = JSON.parse(document.getElementById('reglasData').textContent) || []; } catch (e) { REGLAS = []; }
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; }); }

    // Llena el combo de promociones del tipo elegido: solo las vigentes + la actual aunque ya no lo esté (marcada).
    function llenarReglas(caja, tipo, actualId) {
        var sel = caja.querySelector('[data-destino-regla]');
        if (!tipo) { sel.innerHTML = '<option value="">—</option>'; sel.disabled = true; return; }
        var opts = '<option value="">Elegí una promoción…</option>';
        REGLAS.filter(function (r) { return r.tipo === tipo && (r.vigente || r.id === actualId); }).forEach(function (r) {
            opts += '<option value="' + r.id + '"' + (r.id === actualId ? ' selected' : '') + '>' + esc(r.nombre) + ' — ' + esc(r.resumen) + (r.vigente ? '' : ' (no vigente)') + '</option>';
        });
        if (actualId && !REGLAS.some(function (r) { return r.id === actualId; }))
            opts += '<option value="' + actualId + '" selected>Promoción #' + actualId + ' (eliminada)</option>';
        sel.innerHTML = opts;
        sel.disabled = false;
    }

    function estadoDestino(caja) {
        var id = parseInt(caja.dataset.regla, 10) || 0;
        var lbl = caja.querySelector('[data-destino-estado]');
        if (!id) { lbl.className = 'small mt-1 text-muted'; lbl.textContent = 'Sin enlace: el banner es solo una imagen.'; return; }
        var r = REGLAS.find(function (x) { return x.id === id; });
        if (!r) { lbl.className = 'small mt-1 text-danger'; lbl.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>La promoción asociada ya no existe: el clic muestra un aviso. Elegí otra o quitá el enlace.'; return; }
        if (!r.vigente) { lbl.className = 'small mt-1 text-warning'; lbl.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Lleva a «' + esc(r.nombre) + '», que no está vigente: el clic muestra un aviso.'; return; }
        lbl.className = 'small mt-1 text-success';
        lbl.innerHTML = '<i class="bi bi-link-45deg me-1"></i>Lleva a: <strong>' + esc(r.nombre) + '</strong> (' + esc(r.resumen) + ')';
    }

    lista.querySelectorAll('[data-destino]').forEach(function (caja) {
        var id = parseInt(caja.dataset.regla, 10) || 0;
        var r = id ? REGLAS.find(function (x) { return x.id === id; }) : null;
        var tipo = r ? r.tipo : '';
        caja.querySelector('[data-destino-tipo]').value = tipo;
        // Si la promoción ya no existe no se conoce su tipo: se deja el combo de tipo vacío y el estado avisa.
        llenarReglas(caja, tipo, id);
        estadoDestino(caja);
    });

    lista.addEventListener('change', async function (e) {
        var t = e.target;
        var caja = t.closest('[data-destino]');
        if (!caja) return;
        var fila = caja.closest('.promo-fila');
        var selTipo = caja.querySelector('[data-destino-tipo]');
        var selRegla = caja.querySelector('[data-destino-regla]');

        if (t === selTipo) {
            // Cambiar el tipo: "Sin enlace" guarda de inmediato; un tipo nuevo espera a que se elija la promoción.
            if (!selTipo.value) {
                var rq = await post('Destino', { id: +fila.dataset.id, tipo: null, reglaId: null }, true);
                if (!rq.ok) { alerta(rq.error || 'No se pudo quitar el enlace.'); return; }
                caja.dataset.regla = '';
                llenarReglas(caja, '', 0); estadoDestino(caja);
            } else {
                llenarReglas(caja, selTipo.value, 0);
                var lbl = caja.querySelector('[data-destino-estado]');
                lbl.className = 'small mt-1 text-muted'; lbl.textContent = 'Elegí la promoción a la que lleva el banner.';
            }
            return;
        }
        if (t === selRegla) {
            var reglaId = selRegla.value ? parseInt(selRegla.value, 10) : null;
            var res = await post('Destino', { id: +fila.dataset.id, tipo: selTipo.value || null, reglaId: reglaId }, true);
            if (!res.ok) { alerta(res.error || 'No se pudo guardar el enlace.'); return; }
            caja.dataset.regla = reglaId ? String(reglaId) : '';
            estadoDestino(caja);
            alerta(reglaId ? 'Enlace guardado.' : 'Enlace quitado.', 'success');
        }
    });

    // ── título (se guarda al salir del campo) ───────────────
    lista.addEventListener('change', async function (e) {
        var t = e.target;
        var fila = t.closest('.promo-fila');
        if (!fila) return;

        if (t.matches('[data-titulo]')) {
            var r = await post('Titulo', { id: +fila.dataset.id, titulo: t.value }, true);
            if (!r.ok) alerta(r.error || 'No se pudo guardar el texto.');
            return;
        }

        if (t.matches('[data-reemplazar]')) {
            var f = t.files[0];
            var err = validarArchivo(f);
            if (err) { alerta(err, 'warning'); t.value = ''; return; }
            var blob = await prepararImagen(f);
            var fd = new FormData();
            fd.append('id', fila.dataset.id);
            fd.append('imagen', blob, f.name);
            var res = await post('Reemplazar', fd, false);
            if (res.ok) { location.reload(); return; }
            alerta(res.error || 'No se pudo reemplazar la imagen.');
            t.value = '';
        }
    });

    // ── subir / bajar / eliminar ────────────────────────────
    function renumerar() {
        lista.querySelectorAll('.promo-fila').forEach(function (f, i) { f.querySelector('[data-pos]').textContent = i + 1; });
    }

    lista.addEventListener('click', async function (e) {
        var btn = e.target.closest('[data-accion]');
        if (!btn) return;
        var fila = btn.closest('.promo-fila');
        var accion = btn.dataset.accion;

        if (accion === 'eliminar') {
            if (!confirm('¿Eliminar esta promoción? No se puede deshacer.')) return;
            var r = await post('Eliminar', { id: +fila.dataset.id }, true);
            if (r.ok) { location.reload(); return; }
            alerta(r.error || 'No se pudo eliminar.');
            return;
        }

        var otra = accion === 'subir' ? fila.previousElementSibling : fila.nextElementSibling;
        if (!otra || !otra.classList.contains('promo-fila')) return;
        if (accion === 'subir') lista.insertBefore(fila, otra); else lista.insertBefore(otra, fila);
        renumerar();

        var ids = Array.prototype.map.call(lista.querySelectorAll('.promo-fila'), function (f) { return +f.dataset.id; });
        var res = await post('Reordenar', { ids: ids }, true);
        if (res.ok) { alerta('Orden guardado.', 'success'); return; }
        alerta(res.error || 'No se pudo guardar el orden.');
        setTimeout(function () { location.reload(); }, 1500);
    });
})();
</script>
