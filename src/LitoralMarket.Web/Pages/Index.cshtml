@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
    ViewData["MostrarSinStock"] = Model.MostrarSinStock;
}

@if (Model.Promociones.Count > 0)
{
    <partial name="_CarruselPromociones" model="Model.Promociones"
             view-data='new ViewDataDictionary(ViewData) { { "IntervaloSeg", Model.IntervaloCarruselSegundos } }' />
}

<div class="row mb-4">
    <div class="col text-center">
        <h2>@Model.Titulo</h2>
        <p class="text-muted">Explorá nuestros productos por categoría o usá el buscador</p>
    </div>
</div>

@* ── Productos del Inicio: una sola lista, máximo 20 (últimos por id o selección del administrador) ── *@
@if (!Model.Productos.Any())
{
    <div class="alert alert-info text-center">
        @(Model.SeleccionManual ? "Todavía no hay productos destacados." : "No hay productos disponibles en este momento.")
    </div>
}
else
{
    <section class="mb-5">
        <h4 class="mb-3">
            <i class="bi bi-stars me-2 text-success"></i>@(Model.SeleccionManual ? "Destacados" : "Novedades")
        </h4>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
            @foreach (var producto in Model.Productos)
            {
                <div class="col position-relative">
                    <partial name="_ProductoCard" model="producto" />
                </div>
            }
        </div>
    </section>
}
