@model List<LitoralMarket.Application.DTOs.PromocionCarruselDto>
@* Carrusel de promociones (Inicio y vista previa del admin).
   Pista horizontal con scroll-snap: se desplaza con rueda/dedo/teclado, con las flechas y solo.
   Cada promoción es una tarjeta de producto (.producto-card / .producto-img): la imagen entra
   completa (object-fit: contain), sin deformarse. La lógica está en wwwroot/js/carrusel-promos.js;
   el intervalo (segundos) llega en data-intervalo desde el parámetro IntervaloCarruselPromociones.
   Las 3 primeras imágenes (las visibles en escritorio) cargan de inmediato; el resto, diferidas. *@
@{
    var intervalo = ViewData["IntervaloSeg"] as int? ?? 5;
}
<section class="carrusel-promos mb-4" data-carrusel-promos data-intervalo="@intervalo" aria-roledescription="carrusel" aria-label="Promociones">
    <div class="carrusel-viewport">
        <button type="button" class="carrusel-nav prev" data-carrusel-prev aria-label="Promoción anterior" hidden>
            <i class="bi bi-chevron-left"></i>
        </button>
        <div class="carrusel-track" data-carrusel-track tabindex="0">
            @for (var i = 0; i < Model.Count; i++)
            {
                var p = Model[i];
                <div class="carrusel-slide" role="group" aria-roledescription="diapositiva" aria-label="@(i + 1) de @Model.Count">
                    <div class="card h-100 producto-card">
                        <div class="producto-card-img-link">
                            <img src="/images/promociones/@p.Id?v=@p.Version"
                                 class="card-img-top producto-img"
                                 alt="@(string.IsNullOrWhiteSpace(p.Titulo) ? $"Promoción {i + 1}" : p.Titulo)"
                                 loading="@(i < 3 ? "eager" : "lazy")" fetchpriority="@(i == 0 ? "high" : "auto")" decoding="async" draggable="false" />
                        </div>
                    </div>
                </div>
            }
        </div>
        <button type="button" class="carrusel-nav next" data-carrusel-next aria-label="Promoción siguiente" hidden>
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
</section>
<script src="~/js/carrusel-promos.js" asp-append-version="true" defer></script>
